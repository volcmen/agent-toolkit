#!/usr/bin/env python3
"""Launch a command inside Tattoy with a per-pane animated background.

Usage:
  sbg [--theme NAME|auto] [--fps N] [--opacity F] [--density F] [--script PATH] [--dry-run] -- COMMAND [ARGS...]
  sbg --list
  sbg palette [--theme-file PATH]
  sbg install            # PATH shims + copies plugins/fx/*.lua into ~/.config/sbg/fx/
  sbg doctor             # environment report plus the tail of the tattoy log
  sbg set [KEY=VALUE ...]  # write/merge this pane's override.json; no args prints it
  sbg state [--json]       # merged session/status/override/error view for this pane
  sbg fx list [--json]        # builtins plus scripts in $SBG_FX_DIR (default ~/.config/sbg/fx/)
  sbg fx new NAME              # copy the template to $SBG_FX_DIR/NAME.lua; refuses to overwrite
  sbg fx path NAME              # print a script's path
  sbg fx use NAME|off           # switch this pane to a script or builtin, or clear it
  sbg fx edit NAME               # open $VISUAL/$EDITOR on an existing script

Each zellij pane gets its own effect and seed (derived from ZELLIJ_PANE_ID), so
four panes running `sbg auto -- claude` animate differently. Pane state lives
under $SBG_STATE (default ~/.cache/sbg/panes/<pane identity>), created at
launch and pruned after 24h of inactivity.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
TEMPLATE = ROOT / "configs" / "tattoy.toml.tmpl"
EFFECTS = ("matrix", "plasma", "waves", "stars")
MODES = ("start", "idle", "thinking", "tool", "waiting", "error", "compacting")
PARAM_RANGES = {
    "density": (0.1, 3.0),
    "speed": (0.25, 3.0),
    "hue": (-1.0, 1.0),
    "opacity": (0.05, 1.0),
}
STATE_FILES = ("session", "status", "override", "error")
SHIMS = ("claude", "codex")
FAST_EXIT_SECONDS = 5.0
CUBE_LEVELS = (0, 95, 135, 175, 215, 255)
PANE_STALE_SECONDS = 24 * 60 * 60


def tattoy_config_dir() -> Path:
    """Return Tattoy's config directory for this OS (mirrors the `dirs` crate)."""
    override = os.environ.get("SBG_TATTOY_CONFIG_DIR")
    if override:
        return Path(override)
    if sys.platform == "darwin":
        return Path.home() / "Library" / "Application Support" / "tattoy"
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "tattoy"


def cache_dir() -> Path:
    base = os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache"
    path = Path(base) / "sbg"
    path.mkdir(parents=True, exist_ok=True)
    return path


def fx_dir() -> Path:
    override = os.environ.get("SBG_FX_DIR")
    if override:
        path = Path(override).expanduser()
    else:
        base = os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config"
        path = Path(base) / "sbg" / "fx"
    path.mkdir(parents=True, exist_ok=True)
    return path


def shipped_fx_scripts() -> list[Path]:
    source = ROOT / "plugins" / "fx"
    if not source.is_dir():
        return []
    return sorted(source.glob("*.lua"))


def fx_scripts() -> list[Path]:
    return sorted(fx_dir().glob("*.lua"))


def plugin_binary() -> Path:
    candidates = [
        os.environ.get("SBG_FX"),
        ROOT / "plugins" / "target" / "release" / "sbg-fx",
        shutil.which("sbg-fx"),
    ]
    for candidate in candidates:
        if candidate and Path(candidate).is_file() and os.access(candidate, os.X_OK):
            return Path(candidate).resolve()
    sys.exit("sbg: plugin binary not found; run `cargo build --release` in plugins/ or set SBG_FX")


def pane_identity() -> str:
    return os.environ.get("ZELLIJ_PANE_ID") or os.environ.get("KITTY_WINDOW_ID") or str(os.getppid())


def pane_dir() -> Path:
    override = os.environ.get("SBG_STATE")
    if override:
        return Path(override)
    return cache_dir() / "panes" / pane_identity()


def prune_stale_panes(current: Path) -> None:
    panes_root = cache_dir() / "panes"
    if not panes_root.is_dir():
        return
    now = time.time()
    current_resolved = current.resolve()
    for entry in panes_root.iterdir():
        try:
            if not entry.is_dir() or entry.resolve() == current_resolved:
                continue
            newest = entry.stat().st_mtime
            for item in entry.rglob("*"):
                if item.is_file():
                    newest = max(newest, item.stat().st_mtime)
            if now - newest > PANE_STALE_SECONDS:
                shutil.rmtree(entry)
        except OSError:
            continue


def atomic_write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + f".tmp{os.getpid()}")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def read_json_file(path: Path):
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError, UnicodeDecodeError):
        return "<invalid>"


def merged_state(state_dir: Path) -> dict:
    return {name: read_json_file(state_dir / f"{name}.json") for name in STATE_FILES}


def parse_bool_value(value: str) -> bool:
    lowered = value.lower()
    if lowered == "true":
        return True
    if lowered == "false":
        return False
    raise ValueError(f"invalid boolean {value!r}; use true or false")


def validate_set_args(args: list[str]) -> tuple[dict, dict]:
    direct: dict = {}
    params: dict = {}
    for item in args:
        if "=" not in item:
            raise ValueError(f"invalid argument {item!r}; expected key=value")
        key, _, value = item.partition("=")
        if key == "effect":
            direct["effect"] = None if value == "" else value
            if direct["effect"] is not None and direct["effect"] not in EFFECTS:
                raise ValueError(f"invalid effect {value!r}; choose from {', '.join(EFFECTS)} or empty")
        elif key == "script":
            direct["script"] = None if value == "" else str(Path(value).expanduser())
        elif key == "mode":
            direct["mode"] = None if value == "" else value
            if direct["mode"] is not None and direct["mode"] not in MODES:
                raise ValueError(f"invalid mode {value!r}; choose from {', '.join(MODES)} or empty")
        elif key in ("frozen", "enabled", "director"):
            direct[key] = parse_bool_value(value)
        elif key == "palette":
            params["palette"] = value
        elif key in PARAM_RANGES:
            try:
                number = float(value)
            except ValueError as exc:
                raise ValueError(f"invalid {key} {value!r}; expected a number") from exc
            low, high = PARAM_RANGES[key]
            if not (low <= number <= high):
                raise ValueError(f"invalid {key} {value!r}; expected {low}-{high}")
            params[key] = number
        else:
            raise ValueError(f"unknown key {key!r}")
    return direct, params


def cmd_set(args: list[str]) -> int:
    state_dir = pane_dir()
    override_path = state_dir / "override.json"
    if not args:
        existing = read_json_file(override_path)
        print(json.dumps(existing if isinstance(existing, dict) else {}, indent=2, sort_keys=True))
        return 0
    try:
        direct, params = validate_set_args(args)
    except ValueError as exc:
        print(f"sbg: {exc}", file=sys.stderr)
        return 2
    existing = read_json_file(override_path)
    data = existing if isinstance(existing, dict) else {}
    data.update(direct)
    existing_params = data.get("params")
    existing_params = dict(existing_params) if isinstance(existing_params, dict) else {}
    existing_params.update(params)
    data["params"] = existing_params
    data["v"] = 1
    data["ts"] = time.time()
    atomic_write_json(override_path, data)
    return 0


def cmd_state(args: list[str]) -> int:
    as_json = "--json" in args
    state_dir = pane_dir()
    values = merged_state(state_dir)
    if as_json:
        payload = {"pane": pane_identity(), "dir": str(state_dir), **values}
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0
    for name in STATE_FILES:
        value = values[name]
        if value is None:
            continue
        if value == "<invalid>":
            print(f"{name}.json: <invalid>")
            continue
        age = time.time() - (state_dir / f"{name}.json").stat().st_mtime
        print(f"{name}.json (age {age:.1f}s)")
        print(json.dumps(value, indent=2, sort_keys=True))
    return 0


def cmd_fx_list(args: list[str]) -> int:
    as_json = "--json" in args
    scripts = [{"name": p.stem, "path": str(p)} for p in fx_scripts()]
    if as_json:
        print(json.dumps({"builtins": list(EFFECTS), "scripts": scripts}, indent=2, sort_keys=True))
        return 0
    for name in EFFECTS:
        print(f"{name}\tbuiltin")
    for entry in scripts:
        print(f"{entry['name']}\tscript\t{entry['path']}")
    return 0


def cmd_fx_new(args: list[str]) -> int:
    if len(args) != 1:
        print("sbg: usage: sbg fx new NAME", file=sys.stderr)
        return 2
    name = args[0]
    target = fx_dir() / f"{name}.lua"
    if target.exists():
        print(f"sbg: {target} already exists; edit it directly or choose another name", file=sys.stderr)
        return 1
    template = ROOT / "plugins" / "fx" / "template.lua"
    if not template.is_file():
        print(f"sbg: template missing at {template}", file=sys.stderr)
        return 1
    shutil.copyfile(template, target)
    print(str(target))
    return 0


def cmd_fx_path(args: list[str]) -> int:
    if len(args) != 1:
        print("sbg: usage: sbg fx path NAME", file=sys.stderr)
        return 2
    name = args[0]
    script = fx_dir() / f"{name}.lua"
    if script.is_file():
        print(str(script))
        return 0
    if name in EFFECTS:
        print(f"sbg: {name!r} is a builtin effect with no file; use `sbg fx use {name}`", file=sys.stderr)
        return 1
    print(f"sbg: no fx script or builtin named {name!r}", file=sys.stderr)
    return 1


def cmd_fx_use(args: list[str]) -> int:
    if len(args) != 1:
        print("sbg: usage: sbg fx use NAME|off", file=sys.stderr)
        return 2
    name = args[0]
    if name == "off":
        return cmd_set(["script="])
    script = fx_dir() / f"{name}.lua"
    if script.is_file():
        return cmd_set([f"script={script}"])
    if name in EFFECTS:
        return cmd_set([f"effect={name}", "script="])
    print(f"sbg: no fx script or builtin named {name!r}; try `sbg fx list`", file=sys.stderr)
    return 1


def cmd_fx_edit(args: list[str]) -> int:
    if len(args) != 1:
        print("sbg: usage: sbg fx edit NAME", file=sys.stderr)
        return 2
    name = args[0]
    script = fx_dir() / f"{name}.lua"
    if not script.is_file():
        print(f"sbg: {script} does not exist; run `sbg fx new {name}` first", file=sys.stderr)
        return 1
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR")
    if not editor:
        print("sbg: set $VISUAL or $EDITOR to edit fx scripts", file=sys.stderr)
        return 1
    return subprocess.run([*shlex.split(editor), str(script)], check=False).returncode


def cmd_fx(args: list[str]) -> int:
    if not args:
        print("sbg: usage: sbg fx list|new|path|use|edit ...", file=sys.stderr)
        return 2
    sub, rest = args[0], args[1:]
    if sub == "list":
        return cmd_fx_list(rest)
    if sub == "new":
        return cmd_fx_new(rest)
    if sub == "path":
        return cmd_fx_path(rest)
    if sub == "use":
        return cmd_fx_use(rest)
    if sub == "edit":
        return cmd_fx_edit(rest)
    print(f"sbg: unknown fx subcommand {sub!r}", file=sys.stderr)
    return 2


def install_fx_scripts() -> list[Path]:
    target_dir = fx_dir()
    copied = []
    for source in shipped_fx_scripts():
        target = target_dir / source.name
        if target.exists():
            continue
        shutil.copyfile(source, target)
        copied.append(target)
    return copied


def default_script(theme: str, explicit: Path | None) -> Path | None:
    if explicit is not None:
        return explicit.expanduser()
    if theme != "auto" or os.environ.get("SBG_WORLD", "1") == "0":
        return None
    world = fx_dir() / "world.lua"
    return world if world.is_file() else None


def choose_effect(theme: str) -> str:
    if theme != "auto":
        if theme not in EFFECTS:
            sys.exit(f"sbg: unknown theme {theme!r}; choose from {', '.join(EFFECTS)} or auto")
        return theme
    digest = hashlib.sha256(pane_identity().encode()).digest()
    return EFFECTS[digest[0] % len(EFFECTS)]


def seed_for(identity: str) -> int:
    return int.from_bytes(hashlib.sha256(identity.encode()).digest()[:8], "big")


def render_config(effect: str, plugin: Path, fps: int, opacity: float, log_level: str) -> Path:
    text = TEMPLATE.read_text(encoding="utf-8")
    log_path = cache_dir() / "tattoy.log"
    values = {
        "log_level": log_level,
        "log_path": str(log_path),
        "frame_rate": str(fps),
        "effect": effect,
        "plugin": str(plugin),
        "opacity": f"{opacity:.2f}",
    }
    rendered = text
    for key, value in values.items():
        rendered = rendered.replace(f"@@{key}@@", value)
    if "@@" in rendered:
        sys.exit("sbg: config template has an unfilled placeholder")
    target = cache_dir() / f"tattoy-{effect}-{fps}-{int(opacity * 100)}-{log_level}.toml"
    if not target.exists() or target.read_text(encoding="utf-8") != rendered:
        target.write_text(rendered, encoding="utf-8")
    return target


def kitty_theme_file() -> Path | None:
    for candidate in (
        os.environ.get("SBG_KITTY_THEME"),
        Path.home() / ".config" / "kitty" / "current-theme.conf",
        Path.home() / ".config" / "kitty" / "kitty.conf",
    ):
        if candidate and Path(candidate).is_file():
            return Path(candidate)
    return None


def parse_kitty_colors(text: str) -> dict[str, tuple[int, int, int]]:
    colors: dict[str, tuple[int, int, int]] = {}
    for line in text.splitlines():
        match = re.match(r"^\s*(color\d+|foreground|background)\s+#?([0-9a-fA-F]{6})\s*$", line)
        if match:
            value = int(match.group(2), 16)
            colors[match.group(1)] = (value >> 16 & 0xFF, value >> 8 & 0xFF, value & 0xFF)
    return colors


def xterm_default(index: int) -> tuple[int, int, int]:
    if index < 16:
        base = [
            (0, 0, 0), (205, 0, 0), (0, 205, 0), (205, 205, 0), (0, 0, 238), (205, 0, 205), (0, 205, 205), (229, 229, 229),
            (127, 127, 127), (255, 0, 0), (0, 255, 0), (255, 255, 0), (92, 92, 255), (255, 0, 255), (0, 255, 255), (255, 255, 255),
        ]
        return base[index]
    if index < 232:
        cube = index - 16
        return (CUBE_LEVELS[cube // 36], CUBE_LEVELS[cube // 6 % 6], CUBE_LEVELS[cube % 6])
    gray = 8 + (index - 232) * 10
    return (gray, gray, gray)


def build_palette(colors: dict[str, tuple[int, int, int]]) -> str:
    lines = []
    for index in range(256):
        rgb = colors.get(f"color{index}", xterm_default(index))
        lines.append(f"{index} = [{rgb[0]}, {rgb[1]}, {rgb[2]}]")
    fg = colors.get("foreground", (229, 229, 229))
    bg = colors.get("background", (0, 0, 0))
    lines.append(f"foreground = [{fg[0]}, {fg[1]}, {fg[2]}]")
    lines.append(f"background = [{bg[0]}, {bg[1]}, {bg[2]}]")
    return "\n".join(lines) + "\n"


def ensure_palette(theme_file: Path | None, force: bool = False) -> Path | None:
    config_dir = tattoy_config_dir()
    config_dir.mkdir(parents=True, exist_ok=True)
    palette = config_dir / "palette.toml"
    if palette.exists() and not force:
        return palette
    theme = theme_file or kitty_theme_file()
    if theme is None:
        return None
    palette.write_text(build_palette(parse_kitty_colors(theme.read_text(encoding="utf-8"))), encoding="utf-8")
    return palette


def command_line(argv: list[str]) -> str:
    """Return the string for tattoy's --command, which is split on whitespace.

    Arguments that contain whitespace or shell metacharacters are wrapped in a
    tiny generated script so prompts like `claude "fix the tests"` survive.
    """
    if all(re.fullmatch(r"[A-Za-z0-9_@%+=:,./-]+", arg) for arg in argv):
        return " ".join(argv)
    body = "#!/bin/sh\nexec " + shlex.join(argv) + "\n"
    digest = hashlib.sha256(body.encode()).hexdigest()[:16]
    script = cache_dir() / f"cmd-{digest}.sh"
    if not script.exists() or script.read_text(encoding="utf-8") != body:
        script.write_text(body, encoding="utf-8")
        script.chmod(0o755)
    return str(script)


def shim_dir() -> Path:
    override = os.environ.get("SBG_SHIM_DIR")
    if override:
        return Path(override)
    base = os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share"
    return Path(base) / "sbg" / "shims"


def install_shims() -> Path:
    target = shim_dir()
    target.mkdir(parents=True, exist_ok=True)
    shim = ROOT / "bin" / "sbg-shim"
    for name in SHIMS:
        link = target / name
        if link.is_symlink() or link.exists():
            link.unlink()
        link.symlink_to(shim)
    return target


def path_has_shims(path: str = "") -> bool:
    target = shim_dir()
    for entry in (path or os.environ.get("PATH", "")).split(os.pathsep):
        if entry and Path(entry).resolve() == target.resolve():
            return True
        if entry and any((Path(entry) / name).is_file() and os.access(Path(entry) / name, os.X_OK) for name in SHIMS):
            return False
    return False


def plain(text: str) -> str:
    return re.sub(r"\x1b\[[0-9;]*m", "", text)


def log_tail(lines: int = 20) -> str:
    log = cache_dir() / "tattoy.log"
    if not log.is_file():
        return ""
    return plain("\n".join(log.read_text(encoding="utf-8", errors="replace").splitlines()[-lines:]))


def doctor() -> int:
    tattoy = shutil.which("tattoy")
    print(f"tattoy: {tattoy or 'MISSING (brew install tattoy-org/tap/tattoy)'}")
    try:
        print(f"plugin: {plugin_binary()}")
    except SystemExit as exc:
        print(f"plugin: MISSING ({exc})")
    palette = tattoy_config_dir() / "palette.toml"
    print(f"palette: {palette if palette.is_file() else 'MISSING (run `sbg palette`)'}")
    shims = shim_dir()
    linked = all((shims / name).is_symlink() for name in SHIMS)
    print(f"shims: {shims} ({'linked' if linked else 'not installed; run `sbg install`'})")
    print(f"PATH order: {'shims first' if path_has_shims() else 'real binaries win; prepend ' + str(shims) + ' to PATH'}")
    for name in SHIMS:
        print(f"which {name}: {shutil.which(name) or 'not found'}")
    for key in ("ZELLIJ_PANE_ID", "KITTY_WINDOW_ID", "TERM", "SBG_ACTIVE", "SBG_AUTO", "SBG_THEME", "CLAUDECODE"):
        if key in os.environ:
            print(f"env {key}={os.environ[key]}")
    state_dir = pane_dir()
    exists = state_dir.is_dir()
    print(f"pane dir: {state_dir} ({'exists' if exists else 'missing'})")
    if exists:
        values = merged_state(state_dir)
        session = values["session"] if isinstance(values["session"], dict) else {}
        status = values["status"] if isinstance(values["status"], dict) else {}
        override = values["override"] if isinstance(values["override"], dict) else {}
        error = values["error"] if isinstance(values["error"], dict) else {}
        mode = override.get("mode") or session.get("mode")
        context_pct = status.get("context_pct")
        effect = override.get("effect")
        script = override.get("script")
        message = error.get("message")
        print(f"state: mode={mode} context_pct={context_pct} effect={effect} script={script} error={message}")
        error_path = state_dir / "error.json"
        if error_path.is_file():
            print(f"error.json: {error_path.read_text(encoding='utf-8').strip()}")
    scripts = fx_scripts()
    print(f"fx dir: {fx_dir()} ({len(scripts)} script{'s' if len(scripts) != 1 else ''})")
    tail = log_tail()
    print(f"log: {cache_dir() / 'tattoy.log'}")
    if tail:
        print(tail)
    return 0 if tattoy and linked else 1


def run_tattoy(tattoy: str, argv: list[str], env: dict[str, str]) -> int:
    started = time.monotonic()
    log = cache_dir() / "tattoy.log"
    mark = log.stat().st_size if log.is_file() else 0
    try:
        code = subprocess.run(argv, env=env, check=False).returncode
    except KeyboardInterrupt:
        code = 130
    elapsed = time.monotonic() - started
    if code != 0 or elapsed < FAST_EXIT_SECONDS:
        fresh = ""
        if log.is_file():
            with log.open("rb") as handle:
                handle.seek(mark)
                fresh = plain(handle.read().decode("utf-8", errors="replace").strip())
        print(f"sbg: tattoy exited with status {code} after {elapsed:.1f}s; command was {shlex.join(argv)}", file=sys.stderr)
        if fresh:
            print(fresh, file=sys.stderr)
        print(f"sbg: see `sbg doctor` and {log}", file=sys.stderr)
    return code


def main() -> int:
    raw = sys.argv[1:]
    if raw and raw[0] == "set":
        return cmd_set(raw[1:])
    if raw and raw[0] == "state":
        return cmd_state(raw[1:])
    if raw and raw[0] == "fx":
        return cmd_fx(raw[1:])

    parser = argparse.ArgumentParser(prog="sbg", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("theme", nargs="?", default="auto", help="matrix|plasma|waves|stars|auto (default auto), or palette|install|doctor")
    parser.add_argument("--fps", type=int, default=int(os.environ.get("SBG_FPS", "12")))
    parser.add_argument("--opacity", type=float, default=float(os.environ.get("SBG_OPACITY", "0.6")))
    parser.add_argument("--density", type=float, default=float(os.environ.get("SBG_DENSITY", "1.0")))
    parser.add_argument("--log-level", default=os.environ.get("SBG_LOG_LEVEL", "warn"))
    parser.add_argument("--list", action="store_true", help="list effects and exit")
    parser.add_argument("--dry-run", action="store_true", help="print the tattoy invocation and exit")
    parser.add_argument("--theme-file", type=Path, help="kitty theme file for `sbg palette`")
    parser.add_argument("--script", type=Path, help="launch with SBG_SCRIPT set to this Lua fx script")
    argv = sys.argv[1:]
    command: list[str] = []
    if "--" in argv:
        split = argv.index("--")
        argv, command = argv[:split], argv[split + 1 :]
    args = parser.parse_args(argv)

    if args.list:
        print("\n".join(EFFECTS))
        return 0
    if args.theme == "doctor":
        return doctor()
    if args.theme == "install":
        shims = install_shims()
        Path.home().joinpath(".local", "bin").mkdir(parents=True, exist_ok=True)
        link = Path.home() / ".local" / "bin" / "sbg"
        if link.is_symlink() or link.exists():
            link.unlink()
        link.symlink_to(ROOT / "bin" / "sbg")
        print(f"linked ~/.local/bin/sbg and {shims}/{{{','.join(SHIMS)}}}")
        if not path_has_shims():
            print(f"prepend {shims} to PATH after every other PATH edit in your shell init, e.g. fish: fish_add_path --path --move --prepend {shims}")
        copied = install_fx_scripts()
        print(f"fx scripts: {fx_dir()} ({len(copied)} new, {len(fx_scripts())} total)")
        return 0
    if args.theme == "palette":
        palette = ensure_palette(args.theme_file, force=True)
        if palette is None:
            sys.exit("sbg: no kitty theme found; run `tattoy --capture-palette` in the terminal instead")
        print(f"palette written to {palette}")
        return 0

    if not command:
        parser.error("missing command, e.g. `sbg auto -- claude`")
    if not (1 <= args.fps <= 60):
        parser.error("--fps must be between 1 and 60")
    if not (0.05 <= args.opacity <= 1.0):
        parser.error("--opacity must be between 0.05 and 1.0")

    effect = choose_effect(args.theme)
    plugin = plugin_binary()
    config = render_config(effect, plugin, args.fps, args.opacity, args.log_level)
    ensure_palette(None)
    tattoy = shutil.which("tattoy")
    if tattoy is None:
        sys.exit("sbg: tattoy not on PATH; install with `brew install tattoy-org/tap/tattoy`")

    pane = pane_identity()
    state_dir = pane_dir()
    state_dir.mkdir(parents=True, exist_ok=True)
    try:
        prune_stale_panes(state_dir)
    except OSError:
        pass

    env = dict(os.environ)
    env.update(
        SBG_EFFECT=effect,
        SBG_SEED=str(seed_for(pane)),
        SBG_FPS=str(args.fps),
        SBG_DENSITY=str(args.density),
        SBG_ACTIVE="1",
        SBG_PANE=pane,
        SBG_STATE=str(state_dir),
    )
    script = default_script(args.theme, args.script)
    if script is not None:
        env["SBG_SCRIPT"] = str(script)
    argv = [tattoy, "--main-config", str(config), "--disable-indicator", "--command", command_line(command)]
    if args.dry_run:
        script_part = f" SBG_SCRIPT={env['SBG_SCRIPT']}" if script is not None else ""
        print(
            f"SBG_EFFECT={effect} SBG_SEED={env['SBG_SEED']} SBG_FPS={args.fps} "
            f"SBG_DENSITY={args.density} SBG_ACTIVE=1 SBG_PANE={pane} SBG_STATE={state_dir}{script_part}"
        )
        print(shlex.join(argv))
        return 0
    return run_tattoy(tattoy, argv, env)


if __name__ == "__main__":
    sys.exit(main())
