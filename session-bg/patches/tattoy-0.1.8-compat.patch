+#[derive(Clone, Copy, Debug, Default)]
+enum Mode {
+    #[default]
+    Ground,
+    Escape,
+    Utf8(u8),
+    Csi,
+    Ss3,
+    X10(u8),
+    String {
+        osc: bool,
+        escape: bool,
+    },
+    Paste(usize),
+}
+
+/// Small framing layer: unknown sequences and paste contents are opaque. The
+/// existing termwiz parser remains responsible for recognizing shortcut keys.
+#[derive(Default)]
+struct InputDecoder {
+    mode: Mode,
+    pending: Vec<u8>,
+    // Retain a tiny CSI signature even after a stalled prefix was forwarded.
+    sequence: Vec<u8>,
+    opaque: bool,
+    parser: InputParser,
+}
+
+impl InputDecoder {
+    fn emit(&mut self, output: &mut Vec<ParsedInput>, decode: bool) {
+        if self.pending.is_empty() {
+            return;
+        }
+        let bytes = std::mem::take(&mut self.pending);
+        let event = if decode && !self.opaque && std::str::from_utf8(&bytes).is_ok() {
+            let mut events = self.parser.parse_as_vec(&bytes, false);
+            if events.len() == 1 {
+                events.remove(0)
+            } else {
+                // Unknown sequences must not turn into several shortcut keys.
+                self.parser = InputParser::new();
+                InputEvent::Wake
+            }
+        } else {
+            InputEvent::Wake
+        };
+        if matches!(event, InputEvent::Wake) {
+            if let Some(last) = output.last_mut() {
+                if matches!(last.event, InputEvent::Wake) && last.bytes.len() + bytes.len() <= 4096
+                {
+                    last.bytes.extend(bytes);
+                    return;
+                }
+            }
+        }
+        output.push(ParsedInput { bytes, event });
+    }
+
+    fn finish(&mut self, output: &mut Vec<ParsedInput>, decode: bool) {
+        self.emit(output, decode);
+        self.mode = Mode::Ground;
+        self.opaque = false;
+        self.sequence.clear();
+    }
+
+    fn character(&mut self, byte: u8, output: &mut Vec<ParsedInput>) {
+        self.pending.push(byte);
+        match byte {
+            0xc2..=0xdf => self.mode = Mode::Utf8(1),
+            0xe0..=0xef => self.mode = Mode::Utf8(2),
+            0xf0..=0xf4 => self.mode = Mode::Utf8(3),
+            _ => self.finish(output, true),
+        }
+    }
+
+    fn feed(&mut self, bytes: &[u8]) -> Vec<ParsedInput> {
+        let mut output = Vec::new();
+        for &byte in bytes {
+            // An invalid UTF-8 prefix cannot swallow the following key.
+            if matches!(self.mode, Mode::Utf8(_)) && !(0x80..=0xbf).contains(&byte) {
+                self.finish(&mut output, false);
+            }
+            match self.mode {
+                Mode::Ground => {
+                    if byte == 0x1b {
+                        self.pending.push(byte);
+                        self.mode = Mode::Escape;
+                    } else {
+                        self.character(byte, &mut output);
+                    }
+                }
+                Mode::Escape => match byte {
+                    0x1b => {
+                        self.finish(&mut output, true);
+                        self.pending.push(byte);
+                        self.mode = Mode::Escape;
+                    }
+                    b'[' | b'O' => {
+                        self.pending.push(byte);
+                        self.sequence = self.pending.clone();
+                        self.mode = if byte == b'[' { Mode::Csi } else { Mode::Ss3 };
+                    }
+                    b']' | b'P' | b'_' | b'^' | b'X' => {
+                        self.pending.push(byte);
+                        self.mode = Mode::String {
+                            osc: byte == b']',
+                            escape: false,
+                        };
+                    }
+                    _ => self.character(byte, &mut output),
+                },
+                Mode::Utf8(remaining) | Mode::X10(remaining) => {
+                    self.pending.push(byte);
+                    if remaining == 1 {
+                        self.finish(&mut output, true);
+                    } else {
+                        self.mode = if matches!(self.mode, Mode::Utf8(_)) {
+                            Mode::Utf8(remaining - 1)
+                        } else {
+                            Mode::X10(remaining - 1)
+                        };
+                    }
+                }
+                Mode::Csi | Mode::Ss3 => {
+                    self.pending.push(byte);
+                    if self.sequence.len() < 7 {
+                        self.sequence.push(byte);
+                    }
+                    if (0x40..=0x7e).contains(&byte) {
+                        if self.sequence == b"\x1b[200~" {
+                            self.emit(&mut output, false);
+                            self.mode = Mode::Paste(0);
+                        } else if self.sequence == b"\x1b[M" {
+                            self.mode = Mode::X10(3);
+                        } else {
+                            self.finish(&mut output, true);
+                        }
+                    } else if byte < 0x20 || byte > 0x3f {
+                        self.finish(&mut output, false);
+                    }
+                }
+                Mode::String { osc, escape } => {
+                    self.pending.push(byte);
+                    if (osc && byte == 7) || (escape && byte == b'\\') {
+                        self.finish(&mut output, false);
+                    } else {
+                        self.mode = Mode::String {
+                            osc,
+                            escape: byte == 0x1b,
+                        };
+                    }
+                }
+                Mode::Paste(matched) => {
+                    const END: &[u8] = b"\x1b[201~";
+                    self.pending.push(byte);
+                    let next = if byte == END[matched] {
+                        matched + 1
+                    } else {
+                        usize::from(byte == END[0])
+                    };
+                    if next == END.len() {
+                        self.finish(&mut output, false);
+                    } else {
+                        self.mode = Mode::Paste(next);
+                    }
+                }
+            }
+            if self.pending.len() >= 4096 {
+                self.emit(&mut output, false);
+                self.opaque = true;
+            }
+        }
+        // Stream even unfinished pastes/control strings with bounded memory.
+        if matches!(self.mode, Mode::Paste(_) | Mode::String { .. }) {
+            self.emit(&mut output, false);
+        }
+        output
+    }
+
+    /// Resolve bare Escape promptly. For a truncated sequence, forward the
+    /// prefix but keep its framing state so the suffix cannot trigger shortcuts.
+    fn expire(&mut self) -> Vec<ParsedInput> {
+        let mut output = Vec::new();
+        if matches!(self.mode, Mode::Escape) || self.pending == b"\x1b[" || self.pending == b"\x1bO"
+        {
+            self.finish(&mut output, true);
+        } else {
+            self.emit(&mut output, false);
+            self.opaque = true;
+        }
+        output
+    }
+}
