+#[cfg(test)]
+mod sbg_compat_tests {
+    use super::*;
+    use shadow_terminal::termwiz;
+
+    fn raw(events: &[ParsedInput]) -> Vec<u8> {
+        events
+            .iter()
+            .flat_map(|e| e.bytes.iter().copied())
+            .collect()
+    }
+
+    #[test]
+    fn fragments_preserve_bytes_and_shortcut_boundaries() {
+        let bytes = b"hi\r\x1b[13;2u\xf0\x9f\x8c\x8d\0\xff\x1bt\x1b[999;2u";
+        for split in 0..=bytes.len() {
+            let mut decoder = InputDecoder::default();
+            let mut events = decoder.feed(&bytes[..split]);
+            events.extend(decoder.feed(&bytes[split..]));
+            events.extend(decoder.expire());
+            assert_eq!(raw(&events), bytes);
+            assert_eq!(events.iter().filter(|e| e.bytes == b"\x1bt").count(), 1);
+            let shortcut = events.iter().find(|e| e.bytes == b"\x1bt").unwrap();
+            assert!(matches!(&shortcut.event, InputEvent::Key(k)
+                if k.key == termwiz::input::KeyCode::Char('t')
+                    && k.modifiers == termwiz::input::Modifiers::ALT));
+        }
+    }
+
+    #[test]
+    fn paste_and_control_strings_do_not_trigger_shortcuts() {
+        for bytes in [
+            b"\x1b[200~hi\x1bt\0\xff\x1b[201~".as_slice(),
+            b"\x1b]52;c;\x1bt\x07",
+            b"\x1bP\x1bt\x1b\\",
+        ] {
+            for split in 0..=bytes.len() {
+                let mut decoder = InputDecoder::default();
+                let mut events = decoder.feed(&bytes[..split]);
+                events.extend(decoder.feed(&bytes[split..]));
+                assert_eq!(raw(&events), bytes);
+                assert!(events.iter().all(|e| matches!(e.event, InputEvent::Wake)));
+                assert!(matches!(decoder.mode, Mode::Ground));
+            }
+        }
+    }
+
+    #[test]
+    fn escape_and_incomplete_input_flush_without_another_key() {
+        let mut decoder = InputDecoder::default();
+        assert!(decoder.feed(b"\x1b").is_empty());
+        assert_eq!(raw(&decoder.expire()), b"\x1b");
+        assert!(decoder.feed(b"\x1b[13;").is_empty());
+        assert_eq!(raw(&decoder.expire()), b"\x1b[13;");
+        let suffix = decoder.feed(b"2u");
+        assert_eq!(raw(&suffix), b"2u");
+        assert!(suffix.iter().all(|e| matches!(e.event, InputEvent::Wake)));
+    }
+
+    #[test]
+    fn delayed_paste_opener_still_protects_its_payload() {
+        let mut decoder = InputDecoder::default();
+        assert!(decoder.feed(b"\x1b[20").is_empty());
+        assert_eq!(raw(&decoder.expire()), b"\x1b[20");
+        let events = decoder.feed(b"0~\x1bt\x1b[201~");
+        assert_eq!(raw(&events), b"0~\x1bt\x1b[201~");
+        assert!(events.iter().all(|e| matches!(e.event, InputEvent::Wake)));
+    }
+
+    #[test]
+    fn arbitrary_bytes_are_never_lost_or_duplicated() {
+        let mut seed = 123456_u32;
+        let bytes: Vec<u8> = (0..65536)
+            .map(|_| {
+                seed ^= seed << 13;
+                seed ^= seed >> 17;
+                seed ^= seed << 5;
+                seed as u8
+            })
+            .collect();
+        for size in [1, 7, 128, 4096] {
+            let mut decoder = InputDecoder::default();
+            let mut actual = Vec::new();
+            for chunk in bytes.chunks(size) {
+                actual.extend(raw(&decoder.feed(chunk)));
+                assert!(decoder.pending.len() < 4096);
+            }
+            actual.extend(raw(&decoder.expire()));
+            assert_eq!(actual, bytes);
+        }
+    }
+
+    #[test]
+    fn long_paste_streams_with_bounded_memory() {
+        let mut decoder = InputDecoder::default();
+        assert_eq!(raw(&decoder.feed(b"\x1b[200~")), b"\x1b[200~");
+        for _ in 0..100 {
+            let bytes = vec![b'x'; 4096];
+            assert_eq!(raw(&decoder.feed(&bytes)), bytes);
+            assert!(decoder.pending.is_empty());
+        }
+        assert_eq!(raw(&decoder.feed(b"\x1b[201~after")), b"\x1b[201~after");
+        assert!(matches!(decoder.mode, Mode::Ground));
+    }
+}
